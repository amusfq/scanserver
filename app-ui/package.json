{
  "name": "scanserver-ui",
  "version": "3.4.0",
  "description": "Tailwind and DaisyUI web interface for the Scanserver Rust backend.",
  "author": "amusfq",
  "scripts": {
    "build": "vite build",
    "clean": "npm run clean:dist && npm run clean:modules",
    "clean:dist": "rm -rf ./dist",
    "clean:modules": "rm -rf ./node_modules",
    "dev": "vite",
    "lint": "eslint \"src/**/*.{js,vue}\"",
    "missing-translations": "node missing-translations.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-advanced-cropper": "2.8.9",
    "vue-i18n": "9.14.5",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "daisyui": "^5.7.50",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.2.1"
  },
  "license": "GPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/amusfq/scanserver"
  }
}
